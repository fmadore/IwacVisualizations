        "tr": "?",
        "p": 1,
        "w": 2,
        "of": 2,
        "s": 1200,
        "md": "monologue",
        "l": "mu ake, wulakanta mu ake, hada mu ake da jami'an tsaro. ",
        "m": "To haka zamu ci gaba har mu gaji mu bari?",
        "r": " Ashe dole mu tayan mu kan mu wani abu. Ashe da sai a tsaya ayi wai kudi yace zai",
        "i": 0
      },
      {
        "d": "oath_emphasis",
        "tier": 1,
        "tr": "wallahi",
        "p": 1,
        "w": 2,
        "of": 2,
        "s": 1200,
        "md": "monologue",
        "l": "kasusuwan malam duka wanda muke. Bi biya muna dauka domin malam yana da wani tsari. Wanda malaman kasan nan kar kaf gaba daya. ",
        "m": "Wallahi",
        "r": " babu wanda ya tsaya akan wannan tsari. Kuma wannan tsarin ina mai tabbatar muku da izinin Allah. Wallahi zai",
        "i": 0
      },
      {
        "d": "oath_emphasis",
        "tier": 1,
        "tr": "wallahi",
        "p": 1,
        "w": 2,
        "of": 2,
        "s": 1200,
