<?php
/**
 * Visualizations: minimal per-item partial.
 *
 * Dispatched by ``Visualizations::TEMPLATE_PARTIALS`` for resource
 * templates that don't have a dedicated dashboard but still benefit
 * from a small "where does this item sit in the corpus" view:
 *
 *   * 9  Audio              → ``audiovisual`` subset
 *   * 19 Video recording    → ``audiovisual`` subset
 *   * 23 YouTube video      → ``audiovisual`` subset
 *   * 22 Document           → ``documents`` subset
 *   * 15 Photograph         → ``images`` subset
 *
 * The orchestrator (``minimal-item-dashboard.js``) loads
 * ``files/iwac-visualizations/template-summary.json``, picks the matching subset's
 * slice, and renders through the v0.16.0 dashboardLayout system:
 *
 *   1. Sibling sparkline — year histogram for the slice, with a dot at
 *      the current item's year (no ECharts; pure inline SVG).
 *   2. Similar-items strip — for ``images``, the nearest photographs by
 *      ``embedding_image`` cosine similarity (``similar_by_id``); for
 *      the other subsets, the most-recent N items excluding this one.
 *      The strip is the same renderer the Topic Explorer + per-article
 *      dashboard use; absent similarity scores it just renders plain
 *      link cards.
 *
 * Audiovisual pages additionally scope both to the item's own
 * publisher when the bundle has a slice for it, and lead with a row of
 * channel figures (uploads, span, total and median runtime).
 *
 * Server side renders only the asynchronous container — Omeka already
 * shows the item's bibliographic metadata above the block, so we don't
 * duplicate it.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 * @var string|null $embedHeading  The resource's title, passed only by the embed route
 */

use IwacVisualizations\Site\ItemValue;
use IwacVisualizations\Site\ResourcePageBlockLayout\Visualizations;

// Template ID → HF subset that drives the sibling context: declared beside
// the template dispatch, in Visualizations::MINIMAL_SUBSETS.
$templateMap = Visualizations::MINIMAL_SUBSETS;

$template   = $resource->resourceTemplate();
$templateId = $template ? (int) $template->id() : 0;
$subset     = $templateMap[$templateId] ?? '';

// Pull the current item's year out of dcterms:date so the sparkline
// can place the highlight dot. Bare-year and full ISO dates both
// work; missing dates leave the dot off.
$pubYear = '';
$dateValue = $resource->value('dcterms:date');
if ($dateValue) {
    $dateStr = (string) $dateValue;
    if (preg_match('/^(\d{4})/', $dateStr, $m)) {
        $pubYear = $m[1];
    }
}

// The channel / depositing body. The client normalises this the same
// way the generator normalises its slice keys (NFC + lowercase), so
// nothing here has to reproduce that normalisation — and an item whose
// publisher has no slice simply falls back to the whole subset.
// dcterms:publisher is a linked foaf:Organization item on YouTube videos,
// which `(string) $value` would print as "" — hence ItemValue::text().
$channel = $subset === 'audiovisual' ? ItemValue::text($resource->value('dcterms:publisher')) : '';

// Canonical watch URL (fabio:hasURL on template 23). Only YouTube
// targets are surfaced: this becomes an outbound link, so the host is
// checked (ItemValue::watchUrl) rather than trusting whatever a record holds.
$watchUrl = $subset === 'audiovisual' ? ItemValue::watchUrl(ItemValue::text($resource->value('fabio:hasURL'))) : '';

echo $this->partial('common/iwac-block-shell', Visualizations::shell('item', (int) $resource->id(), $embedHeading ?? null, $this->plugin('translate'), [
    'assets' => [
        'blockCss' => 'minimal-item',
        'needs' => ['echarts' => false,
            'chartOptions' => true,
            'layout'       => true,
        ],
        'bundle' => 'minimal-item-dashboard',
    ],
    'blockClass'   => 'iwac-vis-minimal-item',
    'loading'      => $this->translate('Loading visualisations'),
    'loadingClass' => 'iwac-vis-minimal-item__loading',
    'data'         => [
        'template-id' => $templateId,
        'subset'      => $subset,
        'pub-year'    => $pubYear,
        'channel'     => $channel,
        'watch-url'   => $watchUrl,
    ],
]));
