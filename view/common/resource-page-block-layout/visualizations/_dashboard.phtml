<?php
/**
 * The partial every declaration-only item dashboard renders through.
 *
 * Person (template 5), the four non-person entity types (2, 3, 6, 7),
 * Islamic periodical issues (21) and the eight reference templates each
 * rendered the same single call to `common/iwac-block-shell` from their own
 * file, differing only in the asset declaration, the block class and the
 * loading message. Those now sit in `Visualizations::DASHBOARDS`, beside the
 * template dispatch, and this file renders whichever one the item's template
 * names — the resource-page counterpart of `block-layout/_generic.phtml`.
 *
 * Each JS orchestrator fills the async container from its precomputed
 * `files/iwac-visualizations/<kind>-dashboards/{o_id}.json`. The item's own
 * metadata is already shown by Omeka above the block, so nothing of it is
 * repeated here.
 *
 * `Visualizations::partialFor()` routes here, for the resource page block and
 * the embed route alike, so the template is known to have a row.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 * @var string|null $embedHeading  The resource's title, passed only by the embed route
 */

use IwacVisualizations\Site\ResourcePageBlockLayout\Visualizations;

$template = $resource->resourceTemplate();
$name = Visualizations::dashboardForTemplate($template ? (int) $template->id() : null);
$row = Visualizations::DASHBOARDS[$name ?? ''] ?? null;
if ($row === null) {
    // Unreachable through partialFor(); rendering nothing beats a half-built block.
    return;
}
$row['loading'] = $this->translate($row['loading']);

echo $this->partial('common/iwac-block-shell', Visualizations::shell(
    'item', (int) $resource->id(), $embedHeading ?? null, $this->plugin('translate'), $row
));
