<?php
/**
 * Visualizations: per-article partial.
 *
 * Renders when attached to an item whose resource template is
 * bibo:Article (template id 8 on islam.zmo.de). Dispatched here by
 * Visualizations::TEMPLATE_PARTIALS. Hybrid data path:
 *
 *   1. Sentiment          — extracted server-side from Omeka item
 *                           metadata (iwac:<model><Axis>) via
 *                           SentimentExtractor. Rendered here as three
 *                           dot plots (one per axis, one lane per model);
 *                           no chart library involved.
 *
 *   2. Everything else    — fetched client-side from the precomputed
 *                           files/iwac-visualizations/article-dashboards/{o_id}.json:
 *                           the metrics card row, the context network,
 *                           further reading (shared tags / similar
 *                           content / related scholarship) and spatial
 *                           coverage.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 */

use IwacVisualizations\Site\ResourcePageBlockLayout\SentimentExtractor;

$escapeAttr = $this->plugin('escapeHtmlAttr');
$escapeHtml = $this->plugin('escapeHtml');
$translate  = $this->plugin('translate');
$assetUrl   = $this->plugin('assetUrl');

// ---- Sentiment extraction (server-side from Omeka metadata) ----
$sentiment    = SentimentExtractor::fromItem($resource);
$hasSentiment = SentimentExtractor::hasAny($sentiment);

// Per-model chrome (name / org / short / logo) — single source of truth on
// the extractor, so every lane label in the panel names the same models.
$modelInfo = SentimentExtractor::MODEL_INFO;

// ---- Axis definitions -------------------------------------------------
//
// The panel is organised BY AXIS, not by model: the question a reader
// actually has is "do the three models read this article the same way?",
// and that is only answerable when the three ratings for one axis sit on
// one shared scale, vertically aligned. Grouping by model (the old card
// layout) put the comparable numbers in three separate boxes and then
// needed a radar chart underneath to undo that.
//
// `low` / `high` are the two poles of each 1–5 vocabulary. They reuse the
// controlled-vocabulary msgids (Module::POLARITE_ITEMS and friends), so no
// new translation work is needed to label the scales. `diverging` marks
// the one axis whose midpoint is meaningful — polarity pivots on Neutral,
// whereas centrality and subjectivity just run low → high.
$axes = [
    [
        'title'     => $translate('Polarity'),
        'low'       => $translate('Very negative'),
        'high'      => $translate('Very positive'),
        'diverging' => true,
        'labelKey'  => 'polarite',
        'scoreKey'  => 'polarite_numeric',
        'justKey'   => 'polarite_justification',
    ],
    [
        'title'     => $translate('Centrality'),
        'low'       => $translate('Not addressed'),
        'high'      => $translate('Very central'),
        'diverging' => false,
        'labelKey'  => 'centralite',
        'scoreKey'  => 'centralite_numeric',
        'justKey'   => 'centralite_justification',
    ],
    [
        'title'     => $translate('Subjectivity'),
        'low'       => $translate('Very objective'),
        'high'      => $translate('Very subjective'),
        'diverging' => false,
        'labelKey'  => 'subjectivite_label',
        'scoreKey'  => 'subjectivite_score',
        'justKey'   => 'subjectivite_justification',
    ],
];

// The 1–5 scale as five stops, with the model's rating filled in. Purely
// graphic: the rating is already spelled out in words in the same row, so
// the track is aria-hidden rather than given a redundant label.
//
// `$hint` rides on the marker as a native title, so hovering the point
// names the model and its position on the scale without the reader having
// to trace the dot back to a lane label. Assistive tech reads the lane's
// visible text instead — hence aria-hidden on the track as a whole.
$track = function (int $score, bool $diverging, string $hint = '') use ($escapeAttr): string {
    $out = '<span class="iwac-vis-sent-track'
        . ($diverging ? ' iwac-vis-sent-track--diverging' : '')
        . '" aria-hidden="true">';
    for ($stop = 1; $stop <= 5; $stop++) {
        $on = $stop === $score;
        $out .= '<span class="iwac-vis-sent-stop' . ($on ? ' iwac-vis-sent-stop--on' : '') . '"'
            . ($on && $hint !== '' ? ' title="' . $escapeAttr($hint) . '"' : '')
            . '></span>';
    }
    return $out . '</span>';
};

// How far apart the models are on one axis, as a phrase. Unscored ratings
// ("Not applicable" polarity, score 0) are excluded — they carry no
// position on the scale, so they can neither agree nor disagree — and a
// single rating is left unlabelled since one model cannot form a verdict.
$verdict = function (array $scores) use ($translate): array {
    $scored = [];
    foreach ($scores as $s) {
        if ($s >= 1) $scored[] = $s;
    }
    if (count($scored) < 2) return [];
    $spread = max($scored) - min($scored);
    if ($spread === 0) return ['agree',  $translate('Models agree')];
    if ($spread === 1) return ['near',   $translate('Models nearly agree')];
    return ['differ', $translate('Models disagree')];
};

// Models that rated nothing at all get no lane anywhere.
$ratedModels = [];
foreach (SentimentExtractor::MODELS as $m) {
    if (!empty($sentiment[$m]['rated'])) $ratedModels[] = $m;
}

// The AI sentiment panel is server-rendered (it reads Omeka item metadata, not
// the precomputed bundle) and coexists with the async dashboard, so it rides
// the shell's `append` slot rather than replacing the spinner. Buffer it here.
$sentimentHtml = '';
if ($hasSentiment) {
    ob_start();
?>
    <section class="iwac-vis-panel iwac-vis-panel--wide iwac-vis-article__sentiment"
             data-iwac-no-panel-toolbar="1">
        <h4><?= $translate('AI sentiment') ?></h4>
        <p class="iwac-vis-panel-desc">
            <?= $translate('Polarity, centrality to Islam and Muslim communities, and subjectivity ratings for this article, produced by three AI models (GPT-5.6 Luna, Mistral Small 4, DeepSeek V4 Flash). Read directly from this item’s record.') ?>
        </p>

        <div class="iwac-vis-sent">
            <?php foreach ($axes as $axis):
                // Lanes for this axis, plus the material the header and the
                // reasoning drawer need. A model that rated the article but
                // left THIS axis empty gets no lane here.
                $lanes  = [];
                $scores = [];
                $justs  = [];
                foreach ($ratedModels as $model) {
                    $s     = $sentiment[$model];
                    $label = $s[$axis['labelKey']] ?? null;
                    if (!$label) continue;
                    $score    = (int) ($s[$axis['scoreKey']] ?? 0);
                    $lanes[]  = ['model' => $model, 'label' => $label, 'score' => $score];
                    $scores[] = $score;
                    if (!empty($s[$axis['justKey']])) {
                        $justs[$model] = $s[$axis['justKey']];
                    }
                }
                if (!$lanes) continue;
                $v = $verdict($scores);
            ?>
            <section class="iwac-vis-sent-axis">
                <header class="iwac-vis-sent-axis__head">
                    <h5 class="iwac-vis-sent-axis__title"><?= $escapeHtml($axis['title']) ?></h5>
                    <?php if ($v): ?>
                    <p class="iwac-vis-sent-axis__verdict iwac-vis-sent-axis__verdict--<?= $escapeAttr($v[0]) ?>">
                        <?= $escapeHtml($v[1]) ?>
                    </p>
                    <?php endif; ?>
                </header>

                <div class="iwac-vis-sent-axis__anchors" aria-hidden="true">
                    <span class="iwac-vis-sent-axis__anchor"><?= $escapeHtml($axis['low']) ?></span>
                    <span class="iwac-vis-sent-axis__anchor"><?= $escapeHtml($axis['high']) ?></span>
                </div>

                <ul class="iwac-vis-sent-lanes">
                    <?php foreach ($lanes as $lane):
                        $info    = $modelInfo[$lane['model']];
                        $reading = $translate($lane['label']);
                        $scored  = $lane['score'] >= 1;
                        // Where the reading sits along the scale, as the two
                        // flex weights the narrow-screen layout grows on
                        // either side of it — see the `--iwac-vis-sent-lead`
                        // block in article-dashboard.css. An unscored rating
                        // has no point to sit over, so it stays at the start.
                        $lead  = $scored ? $lane['score'] - 1 : 0;
                        $trail = $scored ? 5 - $lane['score'] : 1;
                        // Composed rather than templated: the model name is a
                        // proper noun and the reading is already translated,
                        // so this needs no msgid of its own.
                        $hint = $scored
                            ? $info['name'] . ' — ' . $reading . ' (' . $lane['score'] . '/5)'
                            : '';
                    ?>
                    <li class="iwac-vis-sent-lane<?= $scored ? '' : ' iwac-vis-sent-lane--unscored' ?>">
                        <span class="iwac-vis-sent-lane__model">
                            <img class="iwac-vis-sent-lane__logo"
                                 src="<?= $escapeAttr($assetUrl('img/ai-logos/' . $info['logo'], 'IwacVisualizations')) ?>"
                                 alt=""
                                 width="18" height="18" loading="lazy">
                            <span class="iwac-vis-sent-lane__name"><?= $escapeHtml($info['name']) ?></span>
                        </span>
                        <?= $track($lane['score'], $axis['diverging'], $hint) ?>
                        <span class="iwac-vis-sent-lane__reading-row"
                              style="--iwac-vis-sent-lead:<?= (int) $lead ?>;--iwac-vis-sent-trail:<?= (int) $trail ?>">
                            <span class="iwac-vis-sent-lane__reading"><?= $escapeHtml($reading) ?></span>
                        </span>
                    </li>
                    <?php endforeach; ?>
                </ul>

                <?php if ($justs): ?>
                <details class="iwac-vis-sent-axis__why">
                    <summary><?= $translate('Show reasoning') ?></summary>
                    <div class="iwac-vis-sent-why">
                        <?php foreach ($justs as $model => $text): ?>
                        <div class="iwac-vis-sent-why__item">
                            <span class="iwac-vis-sent-why__model"><?= $escapeHtml($modelInfo[$model]['name']) ?></span>
                            <p><?= $escapeHtml($text) ?></p>
                        </div>
                        <?php endforeach; ?>
                    </div>
                </details>
                <?php endif; ?>
            </section>
            <?php endforeach; ?>
        </div>
    </section>
<?php
    $sentimentHtml = (string) ob_get_clean();
}

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        // person-dashboard.css is the base dashboard sheet (network toolbar,
        // chord, map styling shared with the person + entity views);
        // article-dashboard.css layers the card grids + sentiment cards on top.
        'blockCss' => ['person-dashboard', 'article-dashboard'],
        'needs' => [
            'maplibre'     => true,
            // The context network is a canvas force graph (d3-force), not an
            // ECharts series — see article-dashboard/network.js.
            'd3'           => true,
            'chartOptions' => true,
            'facetButtons' => true,
            'table'        => true,
            'pagination'   => true,
            'layout'       => true,
        ],
        // Self-registering IIFEs for the client-side panels. The sentiment
        // panel is entirely server-rendered (CSS dot plots, no chart library)
        // and so has no entry here.
        // `dashboard-panels-bridge` MUST load after the per-panel IIFEs — it
        // registers thin wrappers into IWACVis.dashboardLayout so the
        // orchestrator can dispatch via declarative slot arrays.
        'panels' => [
            'article-dashboard/network',
            'article-dashboard/further-reading',
            // Registers its own renderer + hasData predicate, so unlike the
            // two above it needs no entry in dashboard-panels-bridge.
            'article-dashboard/map',
            'shared/dashboard-panels-bridge',
        ],
        'orchestrator' => 'article-dashboard',
    ],
    'blockClass'   => 'iwac-vis-article',
    'heading'      => $this->translate('Visualisations'),
    'loading'      => $this->translate('Loading dashboard'),
    'loadingClass' => 'iwac-vis-article__loading',
    'data'         => ['item-id' => $resource->id()],
    'append'       => $sentimentHtml,
]);
