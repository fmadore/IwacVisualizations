<?php
/**
 * Visualizations: per-item partial for bibliographic references.
 *
 * Dispatched by ``Visualizations::TEMPLATE_PARTIALS`` for the reference
 * templates — 10 Book, 11 Book chapter, 12 Book review, 13 Report,
 * 14 Thesis, 16 Blog post, 17 Communication, 18 Journal article — which
 * together make up the ``references`` HF subset (867 rows across nine
 * resource classes).
 *
 * References were the last content type without a Visualizations
 * surface, and rightly so until 2026-07: they carried only bibliographic
 * metadata, which Omeka's own item page already presents better than a
 * chart could. The pipeline then added extracted full text, an
 * ``embedding_OCR`` in the same space as the articles, LDA topics and
 * word counts — so there is now something to show that the item page
 * cannot: where the work sits in the bibliography's timeline, the works
 * closest to it, and the press coverage it resembles.
 *
 * Renders only the asynchronous container;
 * ``asset/js/charts/reference-dashboard.js`` fetches
 * ``files/iwac-visualizations/reference-dashboards/{o_id}.json``
 * (generated by ``scripts/generate_reference_dashboards.py``). Coverage
 * is partial by nature — roughly half the bibliography has no extracted
 * text — so a missing file removes the block instead of reporting an
 * error, and each panel elides itself when its data is absent.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 */

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'reference-dashboard',
        'needs' => [
            'chartOptions' => true,
            'layout'       => true,
            'renderers'    => [
                'sibling-sparkline',
                'similar-items',
            ],
        ],
        'orchestrator' => 'reference-dashboard',
    ],
    'blockClass'   => 'iwac-vis-reference',
    'heading'      => $this->translate('Visualisations'),
    'loading'      => $this->translate('Loading visualisations'),
    'loadingClass' => 'iwac-vis-reference__loading',
    'data'         => [
        'item-id' => $resource->id(),
    ],
]);
