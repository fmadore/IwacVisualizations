<?php
/**
 * Visualizations: shared partial for non-person entities.
 *
 * Drives the dashboard for Lieux (template 6), Organisations (7),
 * Sujets (3), and Événements (2). Each of those item types resolves
 * to this partial via Visualizations::TEMPLATE_PARTIALS, fetches
 * files/iwac-visualizations/entity-dashboards/{o_id}.json, and renders the same
 * panel set as the person dashboard MINUS the role facet bar (subject
 * vs creator only makes sense for persons).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 */

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'person-dashboard',
        'needs' => [
            'maplibre'     => true,
            // Associated entities offers a d3-force canvas, a DOM/SVG
            // relational list, and a semantic temporal table. None is an
            // ECharts series.
            'd3'           => true,
            'chartOptions' => true,
            'facetButtons' => true,
            'table'        => true,
            'pagination'   => true,
            'layout'       => true,
        ],
        // Reuses the person panel modules: the entity precompute wraps every
        // section in `by_role.all` precisely so these modules work unchanged
        // with a no-op facet. The manifest expresses that as `uses:
        // ['person']` — the same panels/person bundle loads on person and
        // entity pages, zero forked panel JS — and this bundle holds only
        // the orchestrator. (`facet.js` rides along unused: entities have no
        // role facet bar to mount it in.)
        'bundle' => 'entity-dashboard',
    ],
    'blockClass'   => 'iwac-vis-entity',
    'heading'      => $this->translate('Visualisations'),
    'loading'      => $this->translate('Loading dashboard'),
    'loadingClass' => 'iwac-vis-entity__loading',
    'data'         => ['item-id' => $resource->id()],
]);
