<?php
/**
 * Visualizations: person template partial.
 *
 * Renders an async container that the JS orchestrator (person-dashboard.js)
 * fills with dynamic panels by fetching
 * files/iwac-visualizations/person-dashboards/{o_id}.json. The header card has been
 * removed since the same metadata is already shown by Omeka above the
 * resource page block.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 */

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'person-dashboard',
        'needs' => [
            'maplibre'     => true,
            // Associated entities offers a d3-force canvas, a DOM/SVG
            // relational list, and a semantic temporal table. None is an
            // ECharts series.
            'd3'           => true,
            'chartOptions' => true,
            'facetButtons' => true,
            'table'        => true,
            'pagination'   => true,
            'layout'       => true,
        ],
        // The panels (self-registering IIFEs, each hanging a render function
        // off IWACVis.personDashboard) are the panels/person bundle the
        // entity dashboard shares; this bundle is the orchestrator. The
        // wrappers `dashboard-panels-bridge` registers into
        // IWACVis.dashboardLayout ride the shared-layout bundle above. File
        // list and order: asset/js/bundles.json.
        'bundle' => 'person-dashboard',
    ],
    'blockClass'   => 'iwac-vis-person',
    'heading'      => $this->translate('Visualisations'),
    'loading'      => $this->translate('Loading dashboard'),
    'loadingClass' => 'iwac-vis-person__loading',
    'data'         => ['item-id' => $resource->id()],
]);
