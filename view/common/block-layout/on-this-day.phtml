<?php
/**
 * On This Day page block.
 *
 * The module's one deliberate engagement hook: items published on today's
 * date across the collection's decades — newspaper articles and periodical
 * issues with full publication dates, in the Gregorian and Umm al-Qura
 * calendars, in whichever of three layouts the reader picks.
 *
 * Fetches the tiny per-day files
 * `files/iwac-visualizations/on-this-day/{MM-DD}.json` and
 * `…/on-this-day/h/{MM-DD}.json` (built by
 * `scripts/generate_on_this_day.py`, ~7 KB each). It removes itself
 * silently when the Gregorian file is absent — e.g. before the first data
 * sync — because an engagement hook must never render an error banner, and
 * drops just the calendar toggle when the Hijri fan-out is absent, which is
 * what an installation sees between a module update and the admin's next
 * "Pull latest data" run.
 *
 * The one state the client cannot render is the one where there is no client:
 * with scripting off, the whole almanac is a spinner that never stops. The
 * `noscript` slot below is the block's only server-rendered content — a line
 * saying so, and a way into the collection that needs no JavaScript at all.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SitePageBlockRepresentation|null $block
 * @var string|null $layout  Editor's default layout; absent on the embed
 *                           route, which renders the partial without a block.
 */

$escapeHtml = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');

// Core's site item-browse route, not the site's curated browse PAGE: the page
// slug is per-site editorial content, and measurably not the same on the two
// IWAC sites — /s/westafrica/page/browse resolves, /s/afrique_ouest/page/browse
// is a 404 — so it is not something this partial can know. `/s/{slug}/item`
// exists on every Omeka S site and needs no JavaScript. Guarded because the
// embed route renders this partial outside a site page context.
$browseUrl = '';
try {
    $browseUrl = $this->url('site/resource', [
        'site-slug'  => $this->currentSite()->slug(),
        'controller' => 'item',
        'action'     => 'browse',
    ]);
} catch (\Throwable $e) {
    $browseUrl = '';
}

// Two msgids rather than one with markup in it: a translator should never have
// to carry an <a href> through a .po file to move a link inside a sentence.
$noscript = '<p>' . $escapeHtml($this->translate(
    'This block assembles today’s items in your browser, so it needs JavaScript.'
)) . '</p>';
if ($browseUrl !== '') {
    $noscript .= '<p><a href="' . $escapeAttr($browseUrl) . '">'
        . $escapeHtml($this->translate('Browse the collection')) . '</a></p>';
}

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'on-this-day',
        // shared/hijri is no longer listed here: it became an unconditional
        // shared primitive in iwac-assets.phtml when the dashboards' year ×
        // month panel became its third consumer.
        'panels'   => [
            'on-this-day/shared',
            'on-this-day/register',
            'on-this-day/decades',
            'on-this-day/clippings',
        ],
        'orchestrator' => 'on-this-day',
    ],
    'blockClass' => 'iwac-vis-on-this-day',
    'embedSlug'  => 'on-this-day',
    'loading'    => $this->translate('Loading on this day'),
    'noscript'   => $noscript,
    'data'       => [
        'layout' => isset($layout) && $layout
            ? $layout
            : \IwacVisualizations\Site\BlockLayout\OnThisDay::DEFAULT_LAYOUT,
    ],
]);
