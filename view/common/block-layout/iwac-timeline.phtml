<?php
/** Native timeline: the server renders the entire reading view before JS enhances it. */
if (empty($timeline)) {
    echo '<p class="iwac-vis-timeline-unavailable">' . $this->escapeHtml($this->translate(
        'This timeline is temporarily unavailable.'
    )) . '</p>';
    return;
}

$reading = $this->partial('common/timeline-reading', [
    'timeline' => $timeline,
    'instance' => $instance,
]);
// The documents the events cite, under the timeline. A page block only: an
// embed carries no theme stylesheet to lay the theme's cards out.
$sourceList = empty($sources) ? '' : $this->partial('common/timeline-sources', [
    'sources' => $sources,
    'instance' => $instance,
    'scripts' => $sourceScripts ?? [],
]);
echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'iwac-timeline',
        'needs' => ['echarts' => false],
        'bundle' => 'timeline',
    ],
    'blockClass' => 'iwac-vis-timeline',
    'prerendered' => $reading,
    'append' => $sourceList,
    'data' => [
        'timeline' => $timeline['slug'],
        'timeline-locale' => $timeline['locale'],
        'instance' => $instance,
        'start-slide' => $startSlide ?? 'intro',
        'layout' => $layout ?? 'narrative',
        // The timeline's own toolbar carries the copy-embed button
        // (timeline/viewer.js), beside the link and fullscreen controls.
        'embed-own' => '1',
    ],
    // No panels to pin: one embed URL for the whole timeline, which names it
    // (IwacTimeline::embedVariables()); the button is in the toolbar.
    'embedSlug' => 'iwac-timeline',
    'embedQuery' => 'timeline=' . rawurlencode($timeline['slug']),
    'embedWhole' => true,
]);
