<?php
/**
 * Topic Explorer page block.
 *
 * Two-mode block: an overview that lists every LDA-30 topic alongside
 * a clickable treemap, and a per-topic detail view (calendar heatmap +
 * country / newspaper distributions + most representative articles).
 * Both views share the same block container; the orchestrator swaps
 * them client-side.
 *
 * Backed by `files/iwac-visualizations/topic-explorer.json` produced by
 * `scripts/generate_topic_explorer.py`.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SitePageBlockRepresentation $block
 */

echo $this->partial('common/iwac-block-shell', [
    'assets' => [
        'blockCss' => 'topic-explorer',
        'needs' => [
            'chartOptions' => true,
            'layout'       => true,
            // Weighting switch on the topics-over-time panel (dominant
            // topic vs probability-weighted prevalence).
            'facetButtons' => true,
            // The topic map is drawn by calling the BUILDER directly
            // (`ns.chartOptions.treemap`, which `chartOptions` above already
            // supplies), not by dispatching a layout slot — so 'treemap' does
            // NOT belong in this list. It sat here anyway and fetched
            // renderers/treemap.min.js on every Topic Explorer page to
            // register a renderer no slot has ever named. A renderer is
            // needed here only when some slot carries `chart: '<key>'`.
            'renderers'    => [
                'calendar-heatmap',
                'horizontal-bar',
                'similar-items',
            ],
        ],
        'orchestrator' => 'topic-explorer',
    ],
    'blockClass'   => 'iwac-vis-topic-explorer',
    'embedSlug'    => 'topic-explorer',
    'loading'      => $this->translate('Loading Topic Explorer'),
    'loadingClass' => 'iwac-vis-topic-explorer__loading',
]);
