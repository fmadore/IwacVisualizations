<?php
/**
 * IWAC Visualizations — shared asset loader partial.
 *
 * Every IWAC block enqueues the same set of stylesheets, CDN libraries,
 * and IWAC JS modules with only small differences — whether the block
 * needs maps, tables, facet buttons, etc. This partial centralizes all
 * of that so individual templates only declare *what* they need.
 *
 * CDN versions are pinned at the top of the file: single source of
 * truth for every IWAC block. Bump the three constants when upgrading.
 *
 * Usage:
 *
 *     <?php echo $this->partial('common/iwac-assets', [
 *         'blockCss'     => 'collection-overview',
 *         'needs'        => [
 *             'maplibre'     => true,
 *             'wordcloud'    => true,
 *             'd3'           => true,           // canvas force-graph renderer
 *             'chartOptions' => true,
 *             'facetButtons' => true,
 *             'table'        => true,
 *             'pagination'   => true,
 *             'timeline'     => true,           // annotated time series
 *             'concordance'  => true,           // KWIC list (implies pagination)
 *             'layout'       => true,           // declarative dashboard layout
 *             'renderers'    => [               // which shared renderers to load
 *                 'calendar-heatmap',
 *                 'chord',
 *                 'radar-profile',
 *                 'sibling-sparkline',
 *                 'similar-items',
 *                 'sunburst',
 *                 'treemap',
 *             ],
 *         ],
 *         'panels'       => [
 *             'collection-overview/recent-additions',
 *             'collection-overview/languages',
 *             // ...
 *         ],
 *         'orchestrator' => 'collection-overview',
 *     ]); ?>
 *
 * Load order is fixed: stylesheets → CDN libs → IWAC i18n/theme/core →
 * shared primitives → dashboard-layout (if needed) → shared renderers
 * (if needed) → block panels → orchestrator. headScript/headLink
 * de-dupe by URL, so if two partial calls ever clash on a page, each
 * asset is still emitted only once.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string|array|null $blockCss  One sheet name under css/blocks/, or a list
 *                                   of them in load order.
 * @var array|null  $needs
 * @var array|null  $panels
 * @var string|null $orchestrator
 */

// -- CDN versions -------------------------------------------------------
// Single source of truth, pinned to EXACT versions. Floating major tags
// (`@6`) resolve through a short-TTL redirect and silently upgrade the
// live site to untested releases (6.1.0 landed that way on 2026-05-19);
// exact pins are immutable-cached by jsDelivr for a year and make every
// upgrade a deliberate, testable bump of these constants.
$cdnEcharts     = 'https://cdn.jsdelivr.net/npm/echarts@6.1.0/dist/echarts.min.js';
$cdnWordcloud   = 'https://cdn.jsdelivr.net/npm/echarts-wordcloud@2.1.0/dist/echarts-wordcloud.min.js';
// MapLibre 6 is ESM-ONLY. There is no `dist/maplibre-gl.js` in the v6 package
// any more (nor the CSP build) — only `.mjs`, with `"type": "module"` and an
// exports map that offers `import` and nothing else. So this URL is loaded by
// the lazy loader below through a dynamic `import()`, NOT as a classic
// <script>, and the namespace is republished as `window.maplibregl` for the
// map modules that still read that global. Keep the `.mjs` extension: pointing
// this back at `.js` is a 404, not a fallback.
//
// The worker needs no configuration here. v6 derives it from `import.meta.url`
// (→ `maplibre-gl-worker.mjs` next to the main chunk) and, because jsDelivr is
// cross-origin, boots it from a blob shim that re-imports the absolute CDN URL.
// That is the case bundler users must call `setWorkerUrl()` for; loading
// straight from a CDN, as we do, resolves on its own. It does require `blob:`
// in `worker-src` wherever the site enforces a CSP.
$cdnMaplibreJs  = 'https://cdn.jsdelivr.net/npm/maplibre-gl@6.1.0/dist/maplibre-gl.mjs';
$cdnMaplibreCss = 'https://cdn.jsdelivr.net/npm/maplibre-gl@6.1.0/dist/maplibre-gl.css';
// d3-force for the item-page ego networks (~17 KB total, vs the 640 KB
// ECharts bundle they used to lean on for a `graph`/`force` series).
// ORDER IS LOAD-BEARING: the UMD builds all attach to one shared `d3`
// global, and d3-force resolves forceCollide's quadtree, the dispatcher and
// the animation timer off that global at definition time. Loading force
// first leaves `d3.forceCollide` undefined at runtime with no error at load.
// The lazy loader below preserves this order (`async = false`).
$cdnD3 = [
    'https://cdn.jsdelivr.net/npm/d3-dispatch@3.0.1/dist/d3-dispatch.min.js',
    'https://cdn.jsdelivr.net/npm/d3-quadtree@3.0.1/dist/d3-quadtree.min.js',
    'https://cdn.jsdelivr.net/npm/d3-timer@3.0.1/dist/d3-timer.min.js',
    'https://cdn.jsdelivr.net/npm/d3-force@3.0.0/dist/d3-force.min.js',
];

// -- Defaults -----------------------------------------------------------
$blockCss     = isset($blockCss)     ? $blockCss     : null;
$needs        = isset($needs)        ? (array) $needs : [];
$panels       = isset($panels)       ? (array) $panels : [];
$orchestrator = isset($orchestrator) ? $orchestrator : null;

$needMaplibre   = !empty($needs['maplibre']);
$needWordcloud  = !empty($needs['wordcloud']);
$needChartOpts  = !empty($needs['chartOptions']);
// `d3` pulls d3-force + the IWAC canvas force-graph renderer (graph-canvas →
// graph-force → graph-panel). Opt-in: only the item-page ego networks need it.
$needD3         = !empty($needs['d3']);
// `table` implicitly needs pagination — pagination.js is table.js's dep.
$needPagination = !empty($needs['pagination']) || !empty($needs['table']);
$needTable      = !empty($needs['table']);
$needFacets     = !empty($needs['facetButtons']);
$needTimeline   = !empty($needs['timeline']);
// `concordance` implicitly needs pagination — the KWIC list is paginated.
$needConcordance = !empty($needs['concordance']);
if ($needConcordance) {
    $needPagination = true;
}
// Renderers imply the dashboard-layout module they register against.
$rendererList   = isset($needs['renderers']) ? (array) $needs['renderers'] : [];
$needLayout     = !empty($needs['layout']) || !empty($rendererList);

$module = 'IwacVisualizations';

$headLink   = $this->headLink();
$headScript = $this->headScript();

// -- CDN preconnect ------------------------------------------------------
// The on-view lazy loader (bottom of this file) injects the chart
// libraries only when a block nears the viewport — without this hint the
// very first library request also pays DNS + TCP + TLS (~100-200 ms).
// Classic <script>/<link> fetches are non-CORS, so no crossorigin variant
// is needed (a crossorigin preconnect would open a second, unused socket).
$headLink(['rel' => 'preconnect',   'href' => 'https://cdn.jsdelivr.net'], 'PREPEND');
$headLink(['rel' => 'dns-prefetch', 'href' => 'https://cdn.jsdelivr.net'], 'PREPEND');

// -- Stylesheets (minified; regenerate with `npm run build:css`) --------
$headLink->appendStylesheet($this->assetUrl('css/iwac-core.min.css', $module));
// iwac-maplibre.min.css is intentionally NOT enqueued here: the map renders
// on-view only and lives far below the fold, so its stylesheet rides the on-view
// lazy loader (alongside the CDN maplibre.css) instead of render-blocking first
// paint. See $lazyCss below.
// `blockCss` takes a single sheet name or a list, in load order. The list form
// exists for blocks that layer a specialisation over a shared base sheet — the
// article dashboard reuses person-dashboard.css and adds its own on top. Before
// it existed that block reached for a raw headLink in its template, which is
// how it ended up shipping the UNMINIFIED sheet for several releases.
foreach ((array) $blockCss as $sheet) {
    if ($sheet) {
        $headLink->appendStylesheet($this->assetUrl('css/blocks/' . $sheet . '.min.css', $module));
    }
}

// -- Deferred, on-view asset loading -----------------------------------
//
// IWAC dashboards live below the fold, but the libraries they need are heavy
// (echarts ~640 KB + maplibre ~360 KB + wordcloud parse/exec dominate the
// homepage's main-thread time). Rather than emit ~30 eager `<script defer>`
// tags that all download + execute during page load, we collect the ordered
// script list here and hand it to a tiny inline loader (below) that injects
// them — in order, via `async=false` — only once a `.iwac-vis-block` nears the
// viewport. No orchestrator code changes: the same scripts run in the same
// order, just later. If IntersectionObserver is unavailable or no block marker
// is found, the loader falls back to loading immediately, so a chart can never
// be stranded behind its spinner.
//
// $scripts preserves the previous load order exactly: CDN libs → IWAC
// infra (i18n → theme → core) → shared primitives → conditional features →
// dashboard-layout + renderers → block panels → orchestrator (last).
//
// MapLibre is the one exception and is NOT in this list — see $lazyMjs. Being
// ESM-only since v6, it is imported and globalised before the classic chain
// starts rather than taking a slot inside it.
$scripts = [];

// CDN libraries (echarts must precede the IWAC theme + panels).
$scripts[] = $cdnEcharts;
if ($needWordcloud) {
    $scripts[] = $cdnWordcloud;
}
if ($needD3) {
    foreach ($cdnD3 as $d3Script) {
        $scripts[] = $d3Script;
    }
}
$lazyCss = [];
// MapLibre is deliberately NOT appended to $scripts: since v6 it is an ES
// module, so a classic <script> tag would neither execute nor define the
// `maplibregl` global. It travels as its own payload key and the loader
// imports it ahead of the classic chain.
$lazyMjs = null;
if ($needMaplibre) {
    $lazyMjs = $cdnMaplibreJs;
    // The map renders on-view only, so its stylesheets ride along with the loader
    // instead of render-blocking the whole page: the CDN maplibre CSS plus the
    // theme's map overrides (iwac-maplibre.min.css).
    $lazyCss[] = $cdnMaplibreCss;
    $lazyCss[] = $this->assetUrl('css/iwac-maplibre.min.css', $module);
}

// IWAC infrastructure (i18n → theme → dashboard-core).
$scripts[] = $this->assetUrl('js/iwac-i18n.min.js', $module);
$scripts[] = $this->assetUrl('js/iwac-theme.min.js', $module);
$scripts[] = $this->assetUrl('js/dashboard-core.min.js', $module);

// Shared primitives — panels is the base for every other primitive;
// panel-toolbar + responsive are tiny and universally useful. Heavier or
// feature-specific primitives are opt-in via $needs.
//
// panels.js was split into four files in v1.23.0 (DOM/fetch/i18n/status/layout
// core, then controls, map helpers, boot helpers). They all extend the same
// IWACVis.panels object and none reads another at load time, so only the core
// has to come first. Kept unconditional: every block boots through
// panels-boot, and the other two are small enough that gating them on $needs
// would buy less than the extra branch costs in reasoning.
$scripts[] = $this->assetUrl('js/charts/shared/panels.min.js', $module);
$scripts[] = $this->assetUrl('js/charts/shared/panels-controls.min.js', $module);
$scripts[] = $this->assetUrl('js/charts/shared/panels-map.min.js', $module);
$scripts[] = $this->assetUrl('js/charts/shared/panels-boot.min.js', $module);
$scripts[] = $this->assetUrl('js/charts/shared/panel-toolbar.min.js', $module);
// embed.js: adds the per-panel "copy embed code" buttons on the live site and
// drives single-panel selection inside an /iwac-embed/:block/:panel frame. It
// self-inits and no-ops where neither applies, so it's universally enqueued
// (after panel-toolbar, whose toolbar container it reuses).
$scripts[] = $this->assetUrl('js/charts/shared/embed.min.js', $module);
$scripts[] = $this->assetUrl('js/charts/shared/responsive.min.js', $module);
// hijri.js owns the Umm al-Qura month-name table AND the probe-then-trust
// Intl conversion of *today*. Unconditional for the same reason as
// responsive.js above — it is 1.2 KB and has no dependencies — but here the
// duplication argument matters more than the size one: three consumers need
// the month names (the calendar-heatmap renderer, the dashboards' year ×
// month panel, On This Day), and gating it on $needs is exactly how those
// consumers ended up carrying private copies that could drift apart. One
// table, always present, no coordination.
$scripts[] = $this->assetUrl('js/charts/shared/hijri.min.js', $module);
if ($needChartOpts) {
    // chart-options core must load before its four family builders, which
    // extend the same IWACVis.chartOptions namespace in any order.
    $scripts[] = $this->assetUrl('js/charts/shared/chart-options.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/chart-options-bar.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/chart-options-hbar.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/chart-options-graph.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/chart-options-special.min.js', $module);
}
if ($needPagination) {
    $scripts[] = $this->assetUrl('js/charts/shared/pagination.min.js', $module);
}
if ($needTable) {
    $scripts[] = $this->assetUrl('js/charts/shared/table.min.js', $module);
}
if ($needFacets) {
    $scripts[] = $this->assetUrl('js/charts/shared/facet-buttons.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/faceted-chart.min.js', $module);
}
// Annotated time series (event markLines + period markAreas), shared by the
// Scary Terms and Laïcité blocks.
if ($needTimeline) {
    $scripts[] = $this->assetUrl('js/charts/shared/annotated-timeline.min.js', $module);
}
// KWIC / concordance list renderer — highlighted keyword-in-context lines.
if ($needConcordance) {
    $scripts[] = $this->assetUrl('js/charts/shared/concordance.min.js', $module);
}
if ($needMaplibre) {
    $scripts[] = $this->assetUrl('js/charts/shared/maplibre.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/map-popup.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/choropleth.min.js', $module);
}
// Canvas force-graph renderer. Strict order: the painter, then the
// simulation/interaction controller that drives it, then the panel chrome,
// then the IWAC entity vocabulary layered on top of all three.
if ($needD3) {
    $scripts[] = $this->assetUrl('js/charts/shared/graph-canvas.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/graph-force.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/graph-panel.min.js', $module);
    $scripts[] = $this->assetUrl('js/charts/shared/entity-graph.min.js', $module);
}

// Dashboard layout system + opt-in renderers (each renderer self-registers
// into dashboard-layout on load; only declared renderers are emitted).
if ($needLayout) {
    $scripts[] = $this->assetUrl('js/charts/shared/dashboard-layout.min.js', $module);
    foreach ($rendererList as $renderer) {
        // Sanitize: only [a-z0-9-] so the assetUrl path can't be coerced
        // into a directory traversal.
        $clean = preg_replace('/[^a-z0-9\-]/', '', strtolower((string) $renderer));
        if ($clean === '') {
            continue;
        }
        $scripts[] = $this->assetUrl('js/charts/shared/renderers/' . $clean . '.min.js', $module);
    }
}

// Block-specific panel modules, then the orchestrator (LAST).
foreach ($panels as $panel) {
    $scripts[] = $this->assetUrl('js/charts/' . $panel . '.min.js', $module);
}
if ($orchestrator) {
    $scripts[] = $this->assetUrl('js/charts/' . $orchestrator . '.min.js', $module);
}

// -- On-view loader -----------------------------------------------------
// Emitted per block; multiple blocks on one page merge their script lists
// into the same window.IWACVisLazy queue at runtime and only the first arms
// the IntersectionObserver. json_encode keeps slashes escaped so the inline
// payload can never break out of the <script> element.
$payload = json_encode(['scripts' => $scripts, 'css' => $lazyCss, 'mjs' => $lazyMjs]);
$headScript->appendScript(
    '(function(){'
    . 'var S=window.IWACVisLazy=(window.IWACVisLazy||{q:[],css:[],mjs:null,armed:false,done:false});'
    . 'var p=' . $payload . ';'
    . 'p.scripts.forEach(function(u){if(S.q.indexOf(u)<0)S.q.push(u);});'
    . '(p.css||[]).forEach(function(u){if(S.css.indexOf(u)<0)S.css.push(u);});'
    // One map-capable block on the page is enough to arm the import; blocks
    // that merge in later share the single resolved namespace.
    . 'if(p.mjs&&!S.mjs)S.mjs=p.mjs;'
    . 'if(S.armed)return;S.armed=true;'
    . 'function load(){if(S.done)return;S.done=true;'
    . 'S.css.forEach(function(href){var l=document.createElement("link");l.rel="stylesheet";l.href=href;document.head.appendChild(l);});'
    . 'function chain(){S.q.forEach(function(src){var s=document.createElement("script");s.src=src;s.async=false;document.head.appendChild(s);});}'
    // MapLibre 6 is an ES module and publishes no global, so it cannot ride the
    // classic `async=false` queue: import it first, republish the namespace as
    // `window.maplibregl`, and only then run the chain the map modules depend
    // on. This serialises the chain behind one ~560 KB module, which is
    // affordable because the loader already fires 400 px before the block
    // reaches the viewport.
    //
    // A failed import still runs the chain. Every map module guards with
    // `typeof maplibregl === "undefined"` and degrades to a "map unavailable"
    // notice, so a CDN outage must cost the page its map — not its ECharts
    // panels as well.
    . 'if(!S.mjs){chain();return;}'
    . 'import(S.mjs).then(function(m){window.maplibregl=m;},function(e){'
    . 'if(window.console&&console.error)console.error("IWAC: MapLibre failed to load",e);'
    . '}).then(chain,chain);'
    . '}'
    . 'function arm(){var b=document.querySelectorAll(".iwac-vis-block");'
    . 'if(!b.length||!("IntersectionObserver" in window)){load();return;}'
    . 'var io=new IntersectionObserver(function(en){for(var i=0;i<en.length;i++){if(en[i].isIntersecting){io.disconnect();load();return;}}},{rootMargin:"400px 0px"});'
    . 'for(var i=0;i<b.length;i++)io.observe(b[i]);'
    . '}'
    . 'if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",arm);}else{arm();}'
    . '})();'
);
