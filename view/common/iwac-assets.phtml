<?php
/**
 * IWAC Visualizations — shared asset loader partial.
 *
 * Every IWAC block enqueues the same set of stylesheets, CDN libraries,
 * and IWAC JS modules with only small differences — whether the block
 * needs maps, tables, facet buttons, etc. This partial centralizes all
 * of that so individual templates only declare *what* they need.
 *
 * CDN versions are pinned at the top of the file: single source of
 * truth for every IWAC block. Bump the three constants when upgrading.
 *
 * Usage:
 *
 *     <?php echo $this->partial('common/iwac-assets', [
 *         'blockCss'     => 'collection-overview',
 *         'needs'        => [
 *             'maplibre'     => true,           // shared-map bundle + MapLibre
 *             'wordcloud'    => true,           // the echarts-wordcloud plugin
 *             'd3'           => true,           // shared-d3 (canvas force graphs)
 *             'chartOptions' => true,           // shared-charts
 *             'facetButtons' => true,           // any of these five: shared-ui
 *             'table'        => true,
 *             'pagination'   => true,
 *             'timeline'     => true,
 *             'concordance'  => true,
 *             'layout'       => true,           // shared-layout (dashboard layout
 *                                               //   + every shared renderer)
 *         ],
 *         'bundle'       => 'collection-overview',
 *     ]); ?>
 *
 * The JavaScript is loaded as bundles built by scripts/build-js.js from
 * asset/js/bundles.json — the ONE place the load order lives. This partial
 * decides only which bundles a block needs and their fixed order:
 * shared-core (always) → shared-charts → shared-ui → shared-layout →
 * shared-map → shared-d3 → the block's panel sets → the block bundle. What
 * each bundle contains, and in what order, is the manifest's business; the
 * build fails when a source is missing, listed twice, or in no bundle.
 * headScript/headLink de-dupe by URL, so two blocks on one page share every
 * bundle they have in common, and each is executed once.
 *
 * Until v1.62.0 the partial listed ~33 `.min.js` files per block one by one,
 * with the order held here in PHP where nothing could check it.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string|array|null $blockCss  One sheet name under css/blocks/, or a list
 *                                   of them in load order.
 * @var array|null  $needs
 * @var string|null $bundle     The block's entry in asset/js/bundles.json
 *                              (`blocks.<name>`); its orchestrator loads last.
 */

// -- CDN versions -------------------------------------------------------
// Single source of truth, pinned to EXACT versions. Floating major tags
// (`@6`) resolve through a short-TTL redirect and silently upgrade the
// live site to untested releases (6.1.0 landed that way on 2026-05-19);
// exact pins are immutable-cached by jsDelivr for a year and make every
// upgrade a deliberate, testable bump of these constants.
$cdnEcharts     = 'https://cdn.jsdelivr.net/npm/echarts@6.1.0/dist/echarts.min.js';
$cdnWordcloud   = 'https://cdn.jsdelivr.net/npm/echarts-wordcloud@2.1.0/dist/echarts-wordcloud.min.js';
// MapLibre 6 is ESM-ONLY. There is no `dist/maplibre-gl.js` in the v6 package
// any more (nor the CSP build) — only `.mjs`, with `"type": "module"` and an
// exports map that offers `import` and nothing else. So this URL is loaded by
// the lazy loader below through a dynamic `import()`, NOT as a classic
// <script>, and the namespace is republished as `window.maplibregl` for the
// map modules that still read that global. Keep the `.mjs` extension: pointing
// this back at `.js` is a 404, not a fallback.
//
// The worker needs no configuration here. v6 derives it from `import.meta.url`
// (→ `maplibre-gl-worker.mjs` next to the main chunk) and, because jsDelivr is
// cross-origin, boots it from a blob shim that re-imports the absolute CDN URL.
// That is the case bundler users must call `setWorkerUrl()` for; loading
// straight from a CDN, as we do, resolves on its own. It does require `blob:`
// in `worker-src` wherever the site enforces a CSP.
$cdnMaplibreJs  = 'https://cdn.jsdelivr.net/npm/maplibre-gl@6.6.0/dist/maplibre-gl.mjs';
$cdnMaplibreCss = 'https://cdn.jsdelivr.net/npm/maplibre-gl@6.6.0/dist/maplibre-gl.css';
// d3-force for the item-page ego networks (~17 KB total, vs the 640 KB
// ECharts bundle they used to lean on for a `graph`/`force` series).
// ORDER IS LOAD-BEARING: the UMD builds all attach to one shared `d3`
// global, and d3-force resolves forceCollide's quadtree, the dispatcher and
// the animation timer off that global at definition time. Loading force
// first leaves `d3.forceCollide` undefined at runtime with no error at load.
// The lazy loader below preserves this order (`async = false`).
$cdnD3 = [
    'https://cdn.jsdelivr.net/npm/d3-dispatch@3.0.1/dist/d3-dispatch.min.js',
    'https://cdn.jsdelivr.net/npm/d3-quadtree@3.0.1/dist/d3-quadtree.min.js',
    'https://cdn.jsdelivr.net/npm/d3-timer@3.0.1/dist/d3-timer.min.js',
    'https://cdn.jsdelivr.net/npm/d3-force@3.0.0/dist/d3-force.min.js',
];

// -- Defaults -----------------------------------------------------------
$blockCss     = isset($blockCss)     ? $blockCss     : null;
$needs        = isset($needs)        ? (array) $needs : [];
$bundle       = isset($bundle)       ? (string) $bundle : null;

$needMaplibre   = !empty($needs['maplibre']);
$needWordcloud  = !empty($needs['wordcloud']);
// `d3` pulls d3-force + the IWAC canvas force-graph renderer (graph-canvas →
// graph-force → graph-panel). Opt-in: only the item-page ego networks need it.
$needD3         = !empty($needs['d3']);
// -- The bundle manifest --------------------------------------------------
// Read once per request (static), so the partial can validate the block's
// bundle name and follow its `uses` (panel sets shared between blocks). A
// block naming a bundle the manifest does not have is a build-time error in
// scripts/check-blocks.js; here it is a loud one, not a silently blank page.
$plannedBundles = \IwacVisualizations\Site\AssetPlan::bundles($needs, $bundle);

$module = 'IwacVisualizations';

$headLink   = $this->headLink();
$headScript = $this->headScript();

// -- CDN preconnect ------------------------------------------------------
// The on-view lazy loader (bottom of this file) injects the chart
// libraries only when a block nears the viewport — without this hint the
// very first library request also pays DNS + TCP + TLS (~100-200 ms).
// Classic <script>/<link> fetches are non-CORS, so no crossorigin variant
// is needed (a crossorigin preconnect would open a second, unused socket).
$headLink(['rel' => 'preconnect',   'href' => 'https://cdn.jsdelivr.net'], 'PREPEND');
$headLink(['rel' => 'dns-prefetch', 'href' => 'https://cdn.jsdelivr.net'], 'PREPEND');

// A map block pays a SECOND cold connection the moment MapLibre initializes —
// the style JSON from basemaps.cartocdn.com, then tiles and Noto glyph ranges
// from tiles.basemaps.cartocdn.com. Only hinted when the block declares
// 'maplibre', so a chart-only page opens no socket to Carto.
//
// The URLs themselves live in ONE place, `IWACVis.BASEMAP` (asset/js/iwac-theme.js);
// these are its two origins, and `check-maplibre-gates.js` fails the build if
// they drift apart or if a cartocdn literal reappears anywhere else.
if ($needMaplibre) {
    foreach (['https://basemaps.cartocdn.com', 'https://tiles.basemaps.cartocdn.com'] as $origin) {
        $headLink(['rel' => 'preconnect',   'href' => $origin], 'PREPEND');
        $headLink(['rel' => 'dns-prefetch', 'href' => $origin], 'PREPEND');
    }
}

// -- Stylesheets (minified; regenerate with `npm run build:css`) --------
$headLink->appendStylesheet($this->assetUrl('css/iwac-core.min.css', $module));
// iwac-maplibre.min.css is intentionally NOT enqueued here: the map renders
// on-view only and lives far below the fold, so its stylesheet rides the on-view
// lazy loader (alongside the CDN maplibre.css) instead of render-blocking first
// paint. See $lazyCss below.
// `blockCss` takes a single sheet name or a list, in load order. The list form
// exists for blocks that layer a specialisation over a shared base sheet.
// Before it existed, the article dashboard reached for a raw headLink in its
// template, which is how it ended up shipping the UNMINIFIED sheet for several
// releases. That block was also the list form's only user, stacking itself on
// person-dashboard.css for four rules that have since moved to iwac-core —
// a reminder that "shared base sheet" is a claim to measure, not assume: a
// sheet named after one block usually IS about that block.
foreach ((array) $blockCss as $sheet) {
    if ($sheet) {
        $headLink->appendStylesheet($this->assetUrl('css/blocks/' . $sheet . '.min.css', $module));
    }
}

// -- Deferred, on-view asset loading -----------------------------------
//
// IWAC dashboards live below the fold, but the libraries they need are heavy
// (echarts ~640 KB + maplibre ~360 KB + wordcloud parse/exec dominate the
// homepage's main-thread time). Rather than emit ~30 eager `<script defer>`
// tags that all download + execute during page load, we collect the ordered
// script list here and hand it to a tiny inline loader (below) that injects
// them — in order, via `async=false` — only once a `.iwac-vis-block` nears the
// viewport. No orchestrator code changes: the same scripts run in the same
// order, just later. If IntersectionObserver is unavailable or no block marker
// is found, the loader falls back to loading immediately, so a chart can never
// be stranded behind its spinner.
//
// $scripts is: CDN libs → shared-core → the shared bundles this block needs
// → its panel sets → its own bundle (orchestrator last, inside it). Each is
// built by scripts/build-js.js from asset/js/bundles.json.
//
// MapLibre is the one exception and is NOT in this list — see $lazyMjs. Being
// ESM-only since v6 it cannot ride the classic queue, so it is imported
// alongside it, in parallel, and nothing in the chain waits for it: the map
// panels await it individually through P.whenMaplibre().
$scripts = [];

// CDN libraries (echarts must precede the IWAC theme + panels).
if (!isset($needs['echarts']) || $needs['echarts']) {
    $scripts[] = $cdnEcharts;
}
if ($needWordcloud) {
    $scripts[] = $cdnWordcloud;
}
if ($needD3) {
    foreach ($cdnD3 as $d3Script) {
        $scripts[] = $d3Script;
    }
}
$lazyCss = [];
// MapLibre is deliberately NOT appended to $scripts: since v6 it is an ES
// module, so a classic <script> tag would neither execute nor define the
// `maplibregl` global. It travels as its own payload key and the loader
// imports it in parallel with the classic chain.
$lazyMjs = null;
if ($needMaplibre) {
    $lazyMjs = $cdnMaplibreJs;
    // The map renders on-view only, so its stylesheets ride along with the loader
    // instead of render-blocking the whole page: the CDN maplibre CSS plus the
    // theme's map overrides (iwac-maplibre.min.css).
    $lazyCss[] = $cdnMaplibreCss;
    $lazyCss[] = $this->assetUrl('css/iwac-maplibre.min.css', $module);
}

// IWAC bundles, in their fixed order. Every block carries shared-core
// (i18n → theme → dashboard-core → the panels family → panel toolbar →
// embed → responsive → hijri); the rest ride behind their $needs flag.
foreach ($plannedBundles as $plannedBundle) {
    $scripts[] = $this->assetUrl('js/dist/' . $plannedBundle . '.min.js', $module);
}

// -- Nothing waits for MapLibre ----------------------------------------
//
// The orchestrator rides the ordinary chain, map block or not.
//
// It did not always. Map panels read `maplibregl` synchronously inside their
// render(), which P.boot() calls eagerly, so the global had to exist before
// the orchestrator ran — first by `await`ing the import in front of the WHOLE
// chain (~1 MB of MapLibre ahead of echarts and ~30 module files), then, in
// 1.51.0, by gating just the orchestrator. The second is far better and still
// wrong in the same direction: the orchestrator is what paints all twelve
// panels, so on a page whose first nine are ECharts and whose maps sit
// ~4,500 px down, first paint was still behind a library two panels need.
//
// The fix is to stop making the ordering a LOAD-ORDER problem. Map panels now
// await MapLibre individually through `P.whenMaplibre()` (shared/panels-map.js),
// which resolves off the promise the loader publishes below. Every other panel
// paints the moment its own module lands, and a map panel shows its spinner
// for exactly as long as the import takes.

// -- On-view loader -----------------------------------------------------
// Each block has its own manifest and viewport trigger. Shared dependency
// promises deduplicate execution across blocks.
//
// The loader itself is `asset/js/iwac-lazy.js` — a real file, loaded like any
// other script. It used to be ~50 lines of string-concatenated JavaScript
// emitted right here, which made it the only INLINE script on a block page: a
// host with a `script-src 'self'` Content-Security-Policy broke every block
// on the site, and Omeka's headScript has no nonce plumbing to fix that with.
// It was also the one piece of JavaScript deciding when everything else
// loads, with no lint and no tests (H6).
//
// The payload travels as `<script type="application/json">`, which is INERT
// under any CSP because it is data, not code. The HEX flags keep `<`, `&`,
// `'` and `"` escaped so it can never break out of the element.
$lazyManifest = json_encode([
    'error'   => $this->translate('The visualization could not load.'),
    'retry'   => $this->translate('Retry'),
    'scripts' => $scripts,
    'css'     => $lazyCss,
    'mjs'     => $lazyMjs,
], JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);

// The manifest is emitted into the body by `iwac-block-shell`, one per block;
// this script is enqueued once per page and reads all of them.
$headScript->appendFile(
    $this->assetUrl('js/dist/shared-lazy.min.js', $module),
    'text/javascript',
    ['defer' => true]
);

// The caller (iwac-block-shell) echoes this into the body next to the block.
// Laminas captures printed template output; a PHP return value is discarded.
echo $lazyManifest;
