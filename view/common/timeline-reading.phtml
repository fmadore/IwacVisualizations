<?php
use IwacVisualizations\Timeline\Catalog;

$escape = $this->plugin('escapeHtml');
$attr = $this->plugin('escapeHtmlAttr');
$locale = $timeline['locale'];
$events = $timeline['events'];
usort($events, static function ($a, $b) {
    return strcmp($a['start']['value'], $b['start']['value'])
        ?: ($a['sourceOrder'] <=> $b['sourceOrder']);
});
// The introduction lays out the clippings the events cite, each a link to
// its event, so the opening slide is not a heading over an empty stage.
$collage = Catalog::collage($events);
$events = array_merge([$timeline['title']], $events);
// Lucide "link", the icon the module's copy-link buttons draw (P.ICONS.link).
$linkIcon = '<svg class="iwac-vis-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">'
    . '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>'
    . '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
?>
<section class="iwac-vis-timeline__reading" lang="<?= $attr($locale) ?>" aria-labelledby="<?= $attr($instance) ?>-title">
    <header class="iwac-vis-timeline__header">
        <h2 id="<?= $attr($instance) ?>-title"><?= $escape($timeline['title']['headline']) ?></h2>
    </header>
    <div class="iwac-vis-timeline__events">
    <?php foreach ($events as $event):
        $intro = $event['id'] === 'intro';
        $date = Catalog::eventDate($event, $locale);
        $headline = $intro ? $this->translate('Introduction') : ($event['headline'] ?: $date);
        $eventAnchor = $instance . '-' . $event['id'];
        $fragment = '#' . $eventAnchor;
        $media = $event['media'];
        // The axis card's thumbnail.
        $thumb = Catalog::thumbnail($media);
    ?>
        <article class="iwac-vis-timeline__event" id="<?= $attr($eventAnchor) ?>"
                 data-event-id="<?= $attr($event['id']) ?>" data-order="<?= $intro ? '-1' : (int) $event['sourceOrder'] ?>"
                 data-start="<?= $attr($event['start']['value'] ?? '') ?>" data-end="<?= $attr($event['end']['value'] ?? '') ?>"
                 data-date-label="<?= $attr($date) ?>" data-media="<?= $attr($media['type'] ?? '') ?>" data-thumb="<?= $attr($thumb) ?>" aria-labelledby="<?= $attr($eventAnchor) ?>-heading">
            <div class="iwac-vis-timeline__copy">
                <?php if (!$intro): ?>
                <p class="iwac-vis-timeline__dateline">
                    <time datetime="<?= $attr($event['start']['value']) ?>"><?= $escape($date) ?></time>
                </p>
                <?php endif; ?>
                <h3 id="<?= $attr($eventAnchor) ?>-heading"><?= $escape($headline) ?></h3>
                <div class="iwac-vis-timeline__prose"><?= $event['textHtml'] ?></div>
                <a class="iwac-vis-timeline__permalink" href="<?= $attr($fragment) ?>" data-event-link="<?= $attr($event['id']) ?>"><?= $linkIcon ?><span><?= $escape($this->translate('Link to this event')) ?></span></a>
            </div>
            <?php if ($intro && !$media && $collage): // an image the sheet gives the title row wins ?>
            <div class="iwac-vis-timeline__collage">
                <p class="iwac-vis-timeline__collage-label" id="<?= $attr($eventAnchor) ?>-collage"><?= $escape($this->translate('Documents in this timeline')) ?></p>
                <ul aria-labelledby="<?= $attr($eventAnchor) ?>-collage">
                <?php foreach ($collage as $cited):
                    $citedDate = Catalog::eventDate($cited, $locale);
                    // The visible dateline begins the name (WCAG 2.5.3).
                    $citedName = $citedDate . ' · ' . ($cited['headline'] ?: $citedDate);
                ?>
                    <li><a href="#<?= $attr($instance . '-' . $cited['id']) ?>" data-event-link="<?= $attr($cited['id']) ?>" aria-label="<?= $attr($citedName) ?>" title="<?= $attr($citedName) ?>">
                        <span class="iwac-vis-timeline__collage-frame"><img src="<?= $attr(Catalog::thumbnail($cited['media'])) ?>" alt="" width="200" height="200" loading="lazy" decoding="async"></span>
                        <span class="iwac-vis-timeline__collage-date"><?= $escape($citedDate) ?></span>
                    </a></li>
                <?php endforeach; ?>
                </ul>
            </div>
            <?php elseif ($media): ?>
            <figure class="iwac-vis-timeline__media">
                <?php if ($media['type'] === 'image'): ?>
                <a href="<?= $attr($media['url']) ?>" class="iwac-vis-timeline__image-link" target="_blank" rel="noopener">
                    <img src="<?= $attr($media['url']) ?>" alt="<?= $attr($media['alt'] ?: $this->translate('Source document')) ?>" loading="lazy" decoding="async">
                </a>
                <?php else: ?>
                <a href="<?= $attr($media['url']) ?>" class="iwac-vis-timeline__external" target="_blank" rel="noopener"><?= $escape(($media['type'] === 'map' ? $this->translate('View location') : $this->translate('Open linked media'))) ?></a>
                <?php endif; ?>
                <?php if ($media['captionHtml'] || $media['creditHtml']): ?>
                <figcaption>
                    <?= $media['captionHtml'] ?>
                    <?php if ($media['creditHtml']): ?><div class="iwac-vis-timeline__credit"><?= $media['creditHtml'] ?></div><?php endif; ?>
                </figcaption>
                <?php endif; ?>
            </figure>
            <?php endif; ?>
        </article>
    <?php endforeach; ?>
    </div>
</section>
