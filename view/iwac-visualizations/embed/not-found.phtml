<?php
/**
 * Embed 404 — shown when an unknown block slug is requested.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 */
$escapeHtml = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
// The page speaks the site's language, as the embed layout does; it was
// stamped lang="en" over a French title and message.
$locale = \IwacVisualizations\Site\Locale::code($this->siteSetting('locale'), $this->setting('locale'));
?>
<!doctype html>
<html lang="<?= $escapeAttr($locale) ?>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $escapeHtml($this->translate('Visualisation not found')) ?></title>
    <?php
    // The theme's tokens as generated literals, as layout/embed.phtml loads
    // them: without the sheet every var() below painted its fallback.
    ?>
    <link rel="stylesheet" href="<?= $escapeAttr($this->assetUrl('css/iwac-embed-tokens.min.css', 'IwacVisualizations')) ?>">
    <?php
    // Its own rules live in asset/css/iwac-embed.css, not inline, so a host
    // with `style-src 'self'` renders this page as it does every embed page.
    ?>
    <link rel="stylesheet" href="<?= $escapeAttr($this->assetUrl('css/iwac-embed.min.css', 'IwacVisualizations')) ?>">
</head>
<body class="iwac-embed-404-body">
    <div class="iwac-embed-404">
        <h1><?= $escapeHtml($this->translate('Visualisation not found')) ?></h1>
        <p><?= $escapeHtml($this->translate('No embeddable visualisation matches this address.')) ?></p>
    </div>
</body>
</html>
