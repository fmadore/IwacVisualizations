<?php
/**
 * Admin → IWAC Visualizations: pull the precomputed data into files/.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Laminas\Form\Form $form
 * @var array|null $lastSync   ['time','count','bytes','tag'] of the last successful sync, or null.
 * @var \Omeka\Api\Representation\JobRepresentation|null $running  An active sync job, or null.
 * @var \Omeka\Api\Representation\SiteRepresentation[] $sites
 * @var array|null $health     Decoded corpus-health.json (ROADMAP 9.10), or null before the
 *                             first sync that ships it. Metric labels are English-only by
 *                             design (curator tooling; see generate_corpus_health.py).
 */
$escape     = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$translate  = $this->plugin('translate');
$form->prepare();
$health = isset($health) ? $health : null;
?>
<?= $this->pageTitle($translate('IWAC Visualizations')) ?>

<div id="content" class="iwac-data-admin">

    <p>
        <?= $escape($translate(
            'Download the latest precomputed visualization data and unpack it into '
            . 'the site files. The heavy generation runs in GitHub Actions, off this '
            . 'server; this only pulls the published archive. Progress and any errors '
            . 'are logged under Admin → Jobs.'
        )) ?>
    </p>

    <?php if ($running): ?>
    <div class="iwac-data-running">
        <p>
            <strong><?= $escape($translate('A data sync is currently running.')) ?></strong>
            <a href="<?= $escape($this->url('admin/id', [
                'controller' => 'job', 'action' => 'show', 'id' => $running->id(),
            ])) ?>"><?= $escape($translate('View its progress')) ?></a>
        </p>
    </div>
    <?php endif; ?>

    <h3><?= $escape($translate('Current data')) ?></h3>
    <?php if ($lastSync && !empty($lastSync['time'])): ?>
    <dl class="iwac-data-status">
        <dt><?= $escape($translate('Last synced')) ?></dt>
        <dd><?= $escape($lastSync['time']) ?></dd>
        <dt><?= $escape($translate('Files')) ?></dt>
        <dd><?= $escape(number_format((int) ($lastSync['count'] ?? 0))) ?></dd>
        <dt><?= $escape($translate('Archive size')) ?></dt>
        <dd><?= $escape(number_format(((int) ($lastSync['bytes'] ?? 0)) / 1048576, 1)) ?> MB</dd>
        <dt><?= $escape($translate('Source')) ?></dt>
        <dd><?= $escape($lastSync['tag'] ?? 'data') ?></dd>
    </dl>
    <?php else: ?>
    <p class="iwac-data-empty">
        <?= $escape($translate('No data has been pulled yet. Use the button below to fetch it.')) ?>
    </p>
    <?php endif; ?>

    <?php if ($health): ?>
    <h3><?= $escape($translate('Corpus health')) ?></h3>
    <p>
        <?= $escape($translate(
            'Coverage of the upstream enrichment pipelines, computed from the Hugging Face '
            . 'dataset at data-build time. Use these meters to steer digitization and '
            . 'annotation priorities; they refresh with every data pull.'
        )) ?>
        <?php if (!empty($health['generated_at'])): ?>
        <em>(<?= $escape($translate('Computed')) ?> <?= $escape($health['generated_at']) ?>)</em>
        <?php endif; ?>
    </p>
    <style>
        /* Admin-only meters — scoped here because the admin UI is Omeka's
           own chrome, not the IWAC public theme (no token contract). */
        .iwac-health { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px; margin-bottom: 24px; }
        .iwac-health__subset { border: 1px solid #dfdfdf; border-radius: 4px; padding: 12px 16px; }
        .iwac-health__subset h4 { margin: 0 0 8px; text-transform: capitalize; }
        .iwac-health__row { margin: 6px 0; font-size: 13px; }
        .iwac-health__row-head { display: flex; justify-content: space-between; gap: 8px; }
        .iwac-health__pct { font-variant-numeric: tabular-nums; color: #555; }
        .iwac-health__track { height: 6px; border-radius: 3px; background: #e7e7e7; overflow: hidden; margin-top: 3px; }
        .iwac-health__fill { height: 100%; border-radius: 3px; background: #7b9c68; }
        .iwac-health__fill--low { background: #c88a3d; }
    </style>
    <div class="iwac-health">
        <?php foreach ($health['subsets'] as $subsetName => $subset): ?>
        <div class="iwac-health__subset">
            <h4><?= $escape($subsetName) ?> · <?= $escape(number_format((int) ($subset['total'] ?? 0))) ?></h4>
            <?php foreach (($subset['metrics'] ?? []) as $m):
                $total   = max(1, (int) ($m['total'] ?? 0));
                $covered = (int) ($m['covered'] ?? 0);
                $pct     = min(100, round(100 * $covered / $total, 1));
            ?>
            <div class="iwac-health__row">
                <div class="iwac-health__row-head">
                    <span><?= $escape($m['label'] ?? '') ?></span>
                    <span class="iwac-health__pct">
                        <?= $escape(number_format($covered)) ?> / <?= $escape(number_format((int) ($m['total'] ?? 0))) ?>
                        (<?= $escape($pct) ?> %)
                    </span>
                </div>
                <div class="iwac-health__track">
                    <div class="iwac-health__fill<?= $pct < 50 ? ' iwac-health__fill--low' : '' ?>"
                         style="width: <?= $escapeAttr($pct) ?>%"></div>
                </div>
            </div>
            <?php endforeach; ?>
        </div>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>

    <h3><?= $escape($translate('Pull data')) ?></h3>
    <?= $this->form()->openTag($form) ?>
        <?= $this->formRow($form->get('tag')) ?>
        <?= $this->formHidden($form->get('sync_token')) ?>
        <div class="iwac-data-actions">
            <button type="submit" class="button"<?= $running ? ' disabled aria-disabled="true"' : '' ?>>
                <?= $escape($translate('Pull latest data')) ?>
            </button>
        </div>
    <?= $this->form()->closeTag() ?>

    <h3><?= $escape($translate('Iframe embeds')) ?></h3>
    <p>
        <?= $escape($translate(
            'Open a site-specific embed gallery to preview each page-block visualization and copy its iframe snippet.'
        )) ?>
    </p>
    <?php if (!empty($sites)): ?>
    <ul class="iwac-embed-sites">
        <?php foreach ($sites as $site): ?>
        <?php $embedUrl = $this->url('site/iwac-embed', ['site-slug' => $site->slug()]); ?>
        <li>
            <strong><?= $escape($site->title()) ?></strong>
            <code>/s/<?= $escape($site->slug()) ?>/iwac-embed</code>
            <a class="button" href="<?= $escapeAttr($embedUrl) ?>" target="_blank" rel="noopener">
                <?= $escape($translate('Open embed gallery')) ?>
            </a>
        </li>
        <?php endforeach; ?>
    </ul>
    <?php else: ?>
    <p class="iwac-data-empty">
        <?= $escape($translate('No sites are available yet. Create a site before using iframe embeds.')) ?>
    </p>
    <?php endif; ?>

</div>
